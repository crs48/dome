---
import Layout from '../layouts/Layout.astro';
import ConceptImage from '../components/ConceptImage.astro';
import { conceptEntries } from '../lib/concepts';
import { withBase } from '../lib/base';
---
<Layout title="The studies" description="Ten visual studies of the one-room dome: floor living, daylight bathing, adaptable work, mineral and timber shells, and a shared landscape.">
  <div class="habitat habitat-wrap">
    <header class="collection-heading"><p class="eyebrow">The human habitat collection / October 2026</p><h1>Ten ways into<br/>the same idea.</h1><p>A room for an active body, a quieter daily life, and a little more possibility. These independent AI-generated studies explore different parts of that home.</p><a class="line-link" href={withBase('/#room')}>Take the room tour <span aria-hidden="true">↗</span></a></header>
    <div class="study-grid">
      {conceptEntries.map(([key, study]) => <article id={key}>
        <a href={study.image.src} aria-label={`Open full-size study: ${study.title}`}><ConceptImage concept={key} caption={false} sizes="(min-width: 1280px) 600px, (min-width: 521px) 46vw, 94vw" /></a>
        <div class="study-heading"><div><p class="eyebrow">Study {study.number}</p><h2>{study.title}</h2></div><a href={study.image.src} aria-label={`Open full-size ${study.title}`}><span aria-hidden="true">↗</span></a></div>
        <p class="study-caption">{study.caption}</p><p class="quiet-note">{study.note}</p>
      </article>)}
    </div>
    <div class="collection-end"><p class="quiet-note">Generated with OpenAI’s built-in image generation tool. These are visual concepts, not photographs, building plans, or coordinated views of a single measured model.</p><a class="line-link" href={withBase('/about/')}>Image credits & project background <span aria-hidden="true">↗</span></a></div>
  </div>
</Layout>
