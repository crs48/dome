---
import Layout from '../../layouts/ArchiveLayout.astro';
import MethodTable from '../../components/MethodTable.astro';

const caveats = [
  {title: 'Follow the water', body: 'Panel seams and shell openings need a designed water-management system. Ask how water drains, what happens if a seal fails, and how the highest parts are inspected.'},
  {title: 'Comfort is a system', body: 'Insulation, glazing, shade, ventilation and moisture control work together. A single material rating cannot tell you how a whole room will feel.'},
  {title: 'Make space for real life', body: 'Try the furniture layout, storage, acoustics and private spaces. Curved built-ins are one option; a simpler inner room or straight partition may be another.'},
  {title: 'Ask locally, early', body: 'Confirm the documents your building office, insurer and lender need for this exact proposal. An evaluation report has a scope and conditions; it is not a universal permission slip.'},
];
---

<Layout
  title="Build Methods"
  description="Eight approaches to a dome: how their materials, construction and practical questions differ, with sources and a fair way to compare costs."
>
  <div class="mx-auto max-w-6xl px-5 py-14">
    <header class="max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-clay">
        Compare
      </p>
      <h1 class="mt-3 font-display text-4xl text-moss-deep">Same daydream.<br/>Different ingredients.</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        Eight approaches, each with a different set of questions. This is a reading guide, not a product ranking. Start with use and climate, then compare complete assemblies and equally scoped quotes. Supplier links explain their offerings; they are not independent endorsements.
      </p>
    </header>

    <div class="mt-10">
      <MethodTable />
    </div>

    <!-- Four honest caveats about dome living -->
    <section class="mt-16">
      <h2 class="font-display text-2xl text-moss-deep">
        Four honest caveats about dome living
      </h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          caveats.map((c, i) => (
            <li class="rounded-panel border border-line bg-surface/60 p-6">
              <p class="font-mono text-xs text-clay">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-1 text-lg font-semibold text-moss-deep">{c.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{c.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="mt-10 text-xs text-muted">
      Reviewed October 10, 2026. The DIY labels describe potential owner involvement, not a safety rating or permission to build. No universal cost or lifespan numbers are supplied because specifications, labour, site and climate vary.
    </p>
  </div>
</Layout>
