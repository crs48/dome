---
import { withBase } from '../lib/base';
const paths = [
  {id:'home', label:'A home, every day', title:'Start with comfort. Add triangles.', body:'A house has to work on the dreariest Tuesday, too. Explore insulated timber or professionally designed concrete systems, then ask about the complete envelope, daylight, acoustics and privacy.', watch:'A greenhouse kit is not automatically a permitted dwelling. Ask what is included beyond the shell.', href:'/methods#timber-geodesic', cta:'Explore insulated systems'},
  {id:'greenhouse', label:'A home for plants', title:'Your tomatoes have different priorities.', body:'A translucent geodesic kit can make a lovely growing space. Choose crops and ventilation for your actual climate; plants can overheat under all that glorious light.', watch:'Heating a greenhouse through winter can change the energy and cost equation dramatically.', href:'/methods#polycarbonate-geodesic', cta:'Explore translucent shells'},
  {id:'retreat', label:'A little escape', title:'Small dream. Still a real building.', body:'A studio or occasional retreat lets you explore a smaller footprint. Start with how often you will use it, in which seasons, and whether anyone will sleep there.', watch:'“Temporary,” “off-grid” and “tiny” are not universal exemptions from local rules. Confirm the intended use first.', href:'/before-you-build', cta:'Take the reality check'},
];
---
<section class="purpose-section" aria-labelledby="purpose-title">
  <div class="section-kicker">A tiny thought experiment</div>
  <h2 id="purpose-title">What’s your dome doing?</h2>
  <p>A shape is a starting point. What you want to do inside it changes the useful questions.</p>
  <div class="purpose-buttons" role="group" aria-label="Choose a dome use" hidden>
    {paths.map((path,i)=><button type="button" data-purpose={path.id} aria-pressed={i===0} aria-controls={`purpose-${path.id}`}>{path.label}</button>)}
  </div>
  <div class="purpose-results" aria-live="polite" aria-atomic="true">
    {paths.map((path)=><article id={`purpose-${path.id}`} data-purpose-panel={path.id}>
      <p class="section-kicker">{path.label}</p><h3>{path.title}</h3><p>{path.body}</p>
      <p class="field-note"><strong>The catch:</strong> {path.watch}</p>
      <a class="text-link" href={withBase(path.href)}>{path.cta} <span aria-hidden="true">↗</span></a>
    </article>)}
  </div>
  <p class="small-note">A reading guide, not a recommendation for a particular building system. Nothing is stored.</p>
</section>
<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-purpose]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-purpose-panel]')];
  const select = (id: string) => {
    buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.purpose === id)));
    panels.forEach(panel => { panel.hidden = panel.dataset.purposePanel !== id; });
  };
  document.querySelector<HTMLElement>('.purpose-buttons')?.removeAttribute('hidden');
  select('home');
  buttons.forEach(button => button.addEventListener('click', () => select(button.dataset.purpose!)));
</script>
