---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import '../styles/habitat.css';
import { getImage } from 'astro:assets';
import { concepts } from '../lib/concepts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/base';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A home that invites you to move. One generous dome room for floor living, daylight bathing, and an adaptable daily life.',
} = Astro.props;

const fullTitle =
  title === 'Home' ? 'The One-Room Dome — A home that invites you to move' : `${title} · The One-Room Dome`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = await getImage({ src: concepts.timber.image, width: 1200, format: 'jpg', quality: 80 });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(socialImage.src, Astro.site).href} />
    <meta property="og:image:alt" content={concepts.timber.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="icon"
      href={withBase('/favicon.svg')}
      type="image/svg+xml"
    />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded focus:bg-moss focus:px-3 focus:py-2 focus:text-canvas"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
